<robot name="Movemaster_RV-M2">

  <!-- Used for fixing robot to Gazebo 'base_link' -->
<link name="world"/>

<joint name="fixed" type="fixed">
  <parent link="world"/>
  <child link="Base"/>
</joint>

<link name="Base">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="package://movemaster_control/3D_Models/Base.stl" scale="1 1 1.7"/>
    </geometry>
    <material name="BaseColor">
      <color rgba="0.50 0.53 0.47 1"/>
    </material>
  </visual>
  <inertial>
      <mass value="10.0" />
      <inertia ixx="10.5" ixy="0.0" ixz="0.0" iyy="10.5" iyz="0.0" izz="10.5" />
  </inertial>
  <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
