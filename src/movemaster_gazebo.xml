        <mesh filename="package://movemaster_control/3D_Models/Base.stl" scale="1 1 1.7"/>
      </geometry>
  </collision>
</link>

<gazebo reference="Base">
    <selfCollide>true</selfCollide>
    <material>Gazebo/Gray</material>
</gazebo>

<joint name="J1" type="revolute">
